# Copy to .env.local and fill in. Create the uxproof Sanity project at
# https://www.sanity.io/manage; the API token needs Editor permissions.

NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# FastAPI multi-agent service (agent-service/)
AGENT_SERVICE_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8001

# Local LLM for conversational chat answers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Signs the session cookie for email-based sign-in. Any long random string;
# falls back to a fixed dev value when unset.
AUTH_SECRET=generate-a-long-random-string
